# Google Gemini API key used for both multimodal document extraction
# and the CrewAI risk-assessment agents.
GENAI_API_KEY=

# Model used for multimodal (vision) invoice extraction.
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash

# Model used by the CrewAI risk-assessment agents.
GEMINI_AGENT_MODEL=gemini-3.6-flash

# Caps the risk-assessment crew's LLM calls per minute. Google's Gemini API
# free tier allows only 5 requests/minute per model; raise this once a paid
# tier / higher quota is enabled.
GEMINI_MAX_RPM=4

# Optional: path to a customs commission indicative-price workbook (.xlsx) used to detect
# under- and over-invoicing (Agent 7 extension). Real-world reference data, supplied per
# deployment — not committed to the repo. Leave unset to skip this check entirely; it never
# blocks or fails an analysis when unconfigured.
#
# When running via `docker compose` (see docker-compose.yml), set this to the *container*
# path instead — it's already fixed there to /data/customs_price_list.xlsx, so leave this
# line as-is and use CUSTOMS_PRICE_LIST_HOST_PATH below to point at the real file instead.
CUSTOMS_PRICE_LIST_PATH=

# --- The following two are read by docker-compose.yml itself (host-side), not the app ---

# Host port to expose the API on, e.g. http://<server>:8050 . Defaults to 8050 if unset.
HOST_PORT=8050

# Absolute path, on the host running docker compose, to the real customs indicative-price
# workbook. Mounted read-only into the container at /data/customs_price_list.xlsx. Leave
# unset to run without this check (a harmless /dev/null mount).
CUSTOMS_PRICE_LIST_HOST_PATH=
