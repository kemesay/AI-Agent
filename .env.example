# Google Gemini API key used for both multimodal document extraction
# and the CrewAI risk-assessment agents.
GENAI_API_KEY=

# Model used for multimodal (vision) invoice extraction.
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash

# Model used by the CrewAI risk-assessment agents.
GEMINI_AGENT_MODEL=gemini-3.6-flash

# Caps the risk-assessment crew's LLM calls per minute. Google's Gemini API
# free tier allows only 5 requests/minute per model; raise this once a paid
# tier / higher quota is enabled.
GEMINI_MAX_RPM=4

# Path to the customs commission indicative-price workbook (.xlsx) used to detect under-
# and over-invoicing (Agent 7 extension). Defaults to the copy bundled with the package —
# leave this commented out unless you want to override it with an updated/replacement price
# list. IMPORTANT: do not uncomment this with an empty value, that disables the bundled
# default and silently turns the check off.
# CUSTOMS_PRICE_LIST_PATH=/path/to/replacement_price_list.xlsx

# Read by docker-compose.yml itself (host-side), not the app: the host port to expose the
# API on, e.g. http://<server>:8050 . Defaults to 8050 if unset.
HOST_PORT=8050
